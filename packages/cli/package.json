{
  "name": "@loony/cli",
  "version": "0.1.0",
  "private": false,
  "description": "CLI for the Loony design system — init, add components, sync updates, generate themes, and more.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "loony": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/**"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "commander": "^12.1.0",
    "execa": "^9.5.2",
    "fs-extra": "^11.2.0",
    "kleur": "^4.1.5",
    "ora": "^8.1.1",
    "pathe": "^1.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@loony/typescript-config": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
