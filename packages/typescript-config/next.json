{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": false,
    "plugins": [{ "name": "next" }]
  }
}
